# API base URL. Include /api because frontend services call versioned paths such as /v1/leads.
VITE_API_URL=http://localhost:8000/api

# Backward-compatible alias supported by the HTTP client.
VITE_API_BASE_URL=http://localhost:8000/api

# Public frontend URL used by metadata and deployment docs.
VITE_APP_URL=http://localhost:5173
