    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
