# Application
APP_NAME=LeadDesk Mini
APP_VERSION=1.0.0
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=30

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leaddesk-mini?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS and host protection
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost,leaddesk-mini-api.onrender.com

# Review admin account seeded on startup when no admin exists.
ADMIN_EMAIL=admin@leaddesk-mini.dev
ADMIN_PASSWORD=replace-with-a-strong-review-password
ADMIN_FULL_NAME=LeadDesk Admin
