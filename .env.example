# LeadDesk Mini environment reference
# Copy the frontend variables into Vercel and the backend variables into Render.

# Frontend - Vercel
VITE_API_URL=https://leaddesk-mini-api.onrender.com/api
VITE_API_BASE_URL=https://leaddesk-mini-api.onrender.com/api
VITE_APP_URL=https://leaddesk-mini.vercel.app

# Backend - Render
APP_NAME=LeadDesk Mini
APP_VERSION=1.0.0
ENVIRONMENT=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leaddesk-mini?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS=https://leaddesk-mini.vercel.app,http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=leaddesk-mini-api.onrender.com,localhost,127.0.0.1
ADMIN_EMAIL=admin@leaddesk-mini.dev
ADMIN_PASSWORD=replace-with-a-strong-review-password
ADMIN_FULL_NAME=LeadDesk Admin
